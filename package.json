{
  "name": "mcp-industrial-property-scout",
  "version": "1.0.0",
  "description": "Universal Industrial Property Scout MCP Server for Australian properties",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-industrial-scout": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "npm run build && node run-tests.js",
    "test:unit": "npm run build && node tests/unit/framework.test.js",
    "test:integration": "npm run build && node tests/integration/mcp-server.test.js",
    "test:network": "npm run build && node tests/integration/website-assumptions.test.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:network",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "industrial",
    "property",
    "real-estate",
    "australia"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@types/cheerio": "^0.22.35",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.1.2",
    "csv-parse": "^6.1.0",
    "fast-xml-parser": "^5.3.3",
    "https-proxy-agent": "^7.0.6",
    "playwright": "^1.40.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "typescript": "^5.3.0"
  }
}
